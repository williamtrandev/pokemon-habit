# Sao chép file này thành .env rồi điền giá trị từ Supabase Dashboard
# (Project Settings -> API). Cả 2 giá trị này an toàn để lộ ở client — RLS lo phần bảo mật.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Client ID của Google OAuth (Google Cloud Console) — dùng cho đăng nhập Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
