# Sao chép file này thành .env rồi điền giá trị từ Supabase Dashboard
# (Project Settings -> API). Cả 2 giá trị này an toàn để lộ ở client — RLS lo phần bảo mật.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Đồng bộ ẩn danh (không đăng nhập): bật "Anonymous sign-ins" trong
# Supabase Dashboard → Authentication → Providers.
